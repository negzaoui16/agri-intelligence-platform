generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum PinRole {
  FIELD_CENTER
  WELL_CANDIDATE
  SOLAR_ARRAY
  PUMP_INTAKE
  SOIL_SAMPLE
  CUSTOM
}

enum SoilTextureClass {
  SANDY
  SANDY_LOAM
  LOAM
  SILT_LOAM
  CLAY_LOAM
  CLAY
}

enum WaterSourceType {
  RIVER
  STREAM
  CANAL
  LAKE
  RESERVOIR
  WELL
  SPRING
  WATER_INFRASTRUCTURE
}

enum WaterProvider {
  OSM_OVERPASS
  HYDRORIVERS
  HYDROSHEDS
}

enum WeatherObservationType {
  CURRENT_FORECAST
  HISTORICAL_ARCHIVE
}

enum IrrigationMethod {
  DRIP
  SUBSURFACE_DRIP
  SPRINKLER
  CENTER_PIVOT
  FURROW
}

enum FeasibilityVerdict {
  HIGHLY_FEASIBLE
  FEASIBLE_WITH_MITIGATION
  CONDITIONAL
  HIGH_RISK
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  APPLIED
  CONFLICT
  REJECTED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                String    @default("FARMER")
  authProvider        String    @default("EMAIL")
  googleId            String?   @unique
  emailVerified       Boolean   @default(false)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  farmerProfile        FarmerProfile?
  onboardingProgress   OnboardingProgress?
  farms                Farm[]
  conversations        AIConversation[]
  syncOperations       SyncOperation[]
  farmBrainAnalyses    FarmBrainAnalysis[]
  simulationScenarios  SimulationScenario[]
}

model FarmerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  country           String   @default("Tunisia")
  governorate       String?
  delegation        String?
  locality          String?
  preferredLanguage String   @default("en")
  preferredUnits    String   @default("metric")
  experienceLevel   String   @default("YEARS_2_5")
  activityType      String   @default("SMALL_FAMILY_FARM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  userId         String    @unique
  activeFarmId   String?
  currentStep    Int       @default(1)
  completedSteps Json      @default("[]")
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  draftJson      Json?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String?
  country          String?
  region           String?
  governorate      String?
  delegation       String?
  locality         String?
  centerLat        Float
  centerLon        Float
  elevationM       Float?
  areaHectares     Float    @default(1.0)
  perimeterMeters  Float    @default(400.0)
  boundaryVerified Boolean  @default(true)
  primaryCropCode  String   @default("tomato")
  irrigationMethod String   @default("DRIP")
  allowCropOverlap Boolean  @default(false)
  plantingMonth    Int      @default(3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boundary              FarmBoundary?
  locations             FarmLocation[]
  soilProfile           SoilProfile?
  waterSources          WaterSource[]
  waterConfigurations   WaterConfiguration[]
  farmCrops             FarmCrop[]
  weatherObservations   WeatherObservation[]
  solarConfig           SolarConfiguration?
  solarAnalyses         SolarAnalysis[]
  pumpConfig            PumpConfiguration?
  irrigationAnalyses    IrrigationAnalysis[]
  environmentalAnalyses EnvironmentalAnalysis[]
  feasibilityReports    FeasibilityReport[]
  aiConversations       AIConversation[]
  sensorDevices         SensorDevice[]
  sensorReadings        SensorReading[]
  farmBrainAnalyses     FarmBrainAnalysis[]
  simulationScenarios   SimulationScenario[]
  mlPredictionLogs      MLPredictionLog[]

  @@index([userId])
  @@index([centerLat, centerLon])
}

model FarmBoundary {
  id              String                                  @id @default(cuid())
  farmId          String                                  @unique
  geojson         Json
  areaHectares    Float
  perimeterMeters Float
  geom            Unsupported("geometry(Polygon, 4326)")?
  updatedAt       DateTime                                @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([geom], type: Gist)
}

model FarmLocation {
  id         String                                @id @default(cuid())
  farmId     String
  label      String
  role       PinRole                               @default(CUSTOM)
  latitude   Float
  longitude  Float
  elevationM Float?
  notes      String?
  geom       Unsupported("geometry(Point, 4326)")?
  createdAt  DateTime                              @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([geom], type: Gist)
}

model Crop {
  id                   String @id @default(cuid())
  code                 String @unique
  name                 String
  scientificName       String
  category             String
  kcIni                Float
  kcMid                Float
  kcEnd                Float
  stageIniDays         Int
  stageDevDays         Int
  stageMidDays         Int
  stageLateDays        Int
  rootDepthMinM        Float
  rootDepthMaxM        Float
  depletionFractionP   Float
  yieldResponseKy      Float
  optimalTempMinC      Float
  optimalTempMaxC      Float
  droughtTolerance     String
  salinityToleranceDsm Float
}

model SoilProfile {
  id                   String           @id @default(cuid())
  farmId               String           @unique
  textureClass         SoilTextureClass @default(LOAM)
  fieldCapacityMmM     Float
  wiltingPointMmM      Float
  tawMmM               Float
  infiltrationRateMmHr Float
  organicMatterPct     Float?
  ph                   Float?
  source               String           @default("USER_INPUT_OR_DEFAULT")
  updatedAt            DateTime         @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model WaterSource {
  id                  String                                @id @default(cuid())
  farmId              String
  externalId          String
  name                String
  sourceType          WaterSourceType
  provider            WaterProvider
  latitude            Float
  longitude           Float
  distanceMeters      Float
  bearingDegrees      Float
  elevationM          Float?
  elevationDiffM      Float?
  confidence          String
  operationalVerified Boolean                               @default(false)
  metadataJson        Json?
  geom                Unsupported("geometry(Point, 4326)")?
  retrievedAt         DateTime                              @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([geom], type: Gist)
}

model WeatherObservation {
  id               String                 @id @default(cuid())
  farmId           String
  observationType  WeatherObservationType
  currentTempC     Float?
  humidityPct      Float?
  windSpeedKmh     Float?
  windDirectionDeg Float?
  annualPrecipMm   Float?
  annualEt0Mm      Float?
  payloadJson      Json
  retrievedAt      DateTime               @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, observationType])
}

model SolarConfiguration {
  id                 String   @id @default(cuid())
  farmId             String   @unique
  solarStatus        String   @default("YES")
  capacityKwp        Float    @default(5.0)
  panelCount         Int?
  panelWattageW      Float?
  tiltDeg            Float    @default(30.0)
  azimuthDeg         Float    @default(0.0)
  mountingType       String   @default("free")
  systemLossPct      Float    @default(14.0)
  optimizeAngles     Boolean  @default(false)
  hasBattery         Boolean  @default(false)
  batteryCapacityKwh Float?
  hasGridConnection  Boolean  @default(false)
  wantsEstimate      String?
  budgetAmount       Float?
  isFarmerProvided   Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  farm     Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  analyses SolarAnalysis[]
}

model SolarAnalysis {
  id                String   @id @default(cuid())
  farmId            String
  solarConfigId     String?
  dailyAvgKwh       Float
  annualKwh         Float
  optimalTiltDeg    Float?
  optimalAzimuthDeg Float?
  totalLossPct      Float
  monthlyJson       Json
  provider          String   @default("JRC_PVGIS_V5_3")
  retrievedAt       DateTime @default(now())

  farm        Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  solarConfig SolarConfiguration? @relation(fields: [solarConfigId], references: [id], onDelete: SetNull)

  @@index([farmId])
}

model PumpConfiguration {
  id                     String   @id @default(cuid())
  farmId                 String   @unique
  hasPump                Boolean  @default(true)
  pumpType               String?
  powerKw                Float?
  flowRateM3Hr           Float    @default(18.0)
  staticHeadM            Float    @default(15.0)
  pipeLengthM            Float    @default(150.0)
  pipeDiameterMm         Float    @default(75.0)
  pipeMaterialC          Float    @default(140.0)
  frictionLossM          Float    @default(4.2)
  operatingPressureHeadM Float    @default(15.0)
  totalDynamicHeadM      Float    @default(34.2)
  pumpEfficiencyPct      Float    @default(65.0)
  motorEfficiencyPct     Float    @default(88.0)
  operatingHoursDay      Float    @default(6.0)
  isFarmerProvided       Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model FarmCrop {
  id               String   @id @default(cuid())
  farmId           String
  cropCode         String
  cropName         String
  cultivatedAreaHa Float
  areaUnit         String   @default("ha")
  plantingDate     String?
  growthStage      String?
  plotCount        Int      @default(1)
  plantingDensity  String?
  irrigationMethod String   @default("DRIP")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model WaterConfiguration {
  id                String                                @id @default(cuid())
  farmId            String
  sourceType        String
  latitude          Float?
  longitude         Float?
  distanceMeters    Float?
  availability      String?
  wellDepthM        Float?
  flowRateM3Hr      Float?
  waterQualityNotes String?
  isFarmerProvided  Boolean                               @default(true)
  geom              Unsupported("geometry(Point, 4326)")?
  createdAt         DateTime                              @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([geom], type: Gist)
}

model IrrigationAnalysis {
  id                       String           @id @default(cuid())
  farmId                   String
  cropCode                 String
  irrigatedAreaHa          Float
  irrigationMethod         IrrigationMethod @default(DRIP)
  applicationEfficiencyPct Float            @default(90.0)
  annualEtcMm              Float
  annualEffectiveRainMm    Float
  annualNetIrrigationMm    Float
  peakDailyWaterM3         Float
  annualGrossWaterM3       Float
  hydraulicPowerKw         Float
  electricalPowerKw        Float
  dailyPumpEnergyKwh       Float
  annualPumpEnergyKwh      Float
  solarCoveragePct         Float
  worstMonthCoveragePct    Float
  scheduleJson             Json
  retrievedAt              DateTime         @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model EnvironmentalAnalysis {
  id                 String   @id @default(cuid())
  farmId             String
  elevationM         Float
  slopePct           Float
  aridityIndex       Float
  waporAetiMmYr      Float?
  waporRetMmYr       Float?
  waporPcpMmYr       Float?
  waporBiomassKgHa   Float?
  waporNbwpKgM3      Float?
  hydroBasinId       String?
  pfafstetterId      String?
  upstreamAreaKm2    Float?
  basinIrrigationGap Float?
  alertsJson         Json?
  retrievedAt        DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model FeasibilityReport {
  id                String             @id @default(cuid())
  farmId            String
  title             String
  overallScore      Float
  verdict           FeasibilityVerdict
  reportJson        Json
  sourcesJson       Json
  uncertaintiesJson Json
  generatedBy       String             @default("TERRAPULSE_ENGINE")
  createdAt         DateTime           @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([createdAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  farmId    String?
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm     Farm?       @relation(fields: [farmId], references: [id], onDelete: SetNull)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([farmId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolCallsJson  Json?
  citationsJson  Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model SyncOperation {
  id              String     @id @default(cuid())
  operationId     String     @unique
  userId          String
  entityType      String
  entityId        String
  action          SyncAction
  payloadJson     Json
  clientTimestamp DateTime
  serverTimestamp DateTime   @default(now())
  status          SyncStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverTimestamp])
}

model SensorDevice {
  id         String          @id @default(cuid())
  farmId     String
  name       String
  tokenHash  String          @unique
  createdAt  DateTime        @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  farm     Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  readings SensorReading[]

  @@index([farmId])
  @@index([tokenHash])
}

model SensorReading {
  id              String   @id @default(cuid())
  deviceId        String
  farmId          String
  recordedAt      DateTime
  receivedAt      DateTime @default(now())
  airTempC        Float?
  airHumidityPct  Float?
  soilMoisturePct Float?
  soilRaw         Int?
  waterLevelPct   Float?
  waterRaw        Int?
  pumpOn          Boolean  @default(false)
  soilFault       Boolean  @default(false)

  device SensorDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  farm   Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, recordedAt])
  @@index([deviceId, recordedAt])
}

enum SimulationScenarioType {
  WATER_SHORTAGE
  CHANGE_CROP
  WEATHER_CLIMATE
  IRRIGATION_STRATEGY
  FARM_EXPANSION
}

model FarmBrainAnalysis {
  id                  String   @id @default(cuid())
  farmId              String
  userId              String
  version             Int      @default(1)
  dataCompletenessPct Float    @default(0)
  completenessJson    Json
  savingsJson         Json
  verifiedTrackingJson Json
  forecastJson        Json
  plotBreakdownsJson  Json
  recommendationsJson Json
  soilAnomalyDetected Boolean  @default(false)
  soilAnomalyReason   String?
  mlModelsJson        Json
  assumptionsJson     Json
  limitationsJson     Json
  generatedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmId, generatedAt])
  @@index([userId, updatedAt])
}

model SimulationScenario {
  id           String                 @id @default(cuid())
  farmId       String
  userId       String
  name         String
  scenarioType SimulationScenarioType
  inputsJson   Json
  resultJson   Json?
  isArchived   Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lastRunAt    DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmId, updatedAt])
  @@index([userId, isArchived])
}

model MLModelMetadata {
  id             String   @id @default(cuid())
  modelName      String   @unique
  algorithm      String
  version        String
  targetVariable String
  mae            Float
  rmse           Float
  r2             Float
  trainSamples   Int
  testSamples    Int
  featureNames   Json
  trainedAt      DateTime @default(now())
}

model MLPredictionLog {
  id            String   @id @default(cuid())
  farmId        String
  modelName     String
  inputSummary  Json
  outputSummary Json
  provenance    String
  createdAt     DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
}

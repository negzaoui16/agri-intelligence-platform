# Database (PostgreSQL + PostGIS; falls back to local persistent JSON/IndexedDB store if unreachable)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_intelligence?schema=public"

# AI Assistant (Groq API - configurable model, never hardcoded)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"

# External Scientific Engines (All configurable via env with sensible defaults)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1"
PVGIS_API_BASE_URL="https://re.jrc.ec.europa.eu/api/v5_3"
OVERPASS_API_URLS="https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter"
WAPOR_API_BASE_URL="https://data.apps.fao.org/gismgr/api/v2/catalog/workspaces/WAPOR-3"
HYDROBASINS_API_URL="https://services.arcgis.com/v01gqwM5QqNysAAi/arcgis/rest/services/Hydrobasins/FeatureServer/0"
HYDROBASINS_DEMAND_API_URL="https://services1.arcgis.com/hLJbHVT9ZrDIzK0I/arcgis/rest/services/hydrobasins_lvl7_base_jinnan/FeatureServer/0"

# Security & Authentication (Google OAuth optional; local email/password + callback always work)
# Signs login cookies. Production refuses to start sign-ins without a long random value:
#   openssl rand -base64 48
AUTH_SECRET="agri-intelligence-platform-dev-secret-change-in-production"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TerraPulse Agri Intelligence"
NEXT_PUBLIC_DEFAULT_LAT="36.7525"
NEXT_PUBLIC_DEFAULT_LON="3.0420"
